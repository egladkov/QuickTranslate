<Window x:Class="QuickTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickTranslate.ViewModels"
        xmlns:models="clr-namespace:QuickTranslate.Models"
        xmlns:infra="clr-namespace:QuickTranslate.Infrastructure"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{DynamicResource Settings_WindowTitle}"
        Icon="{x:Static infra:AppIcon.ImageSource}"
        Width="520"
        Height="700"
        MinHeight="580"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Status message -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="{x:Static infra:AppIcon.ImageSource}"
                   Width="38"
                   Height="38"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Settings_HeaderTitle}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Settings_HeaderSubtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Settings Cards ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- 1. Language Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_LanguageCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings_LanguageDescription}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AppLanguageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableAppLanguages}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding SelectedAppLanguage}"
                                      Padding="6,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Hotkey Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_HotkeyCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings_HotkeyDescription}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Modifiers checkboxes -->
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Content="Ctrl" IsChecked="{Binding IsControl}" Margin="0,0,16,6" FontWeight="Medium"/>
                            <CheckBox Content="Shift" IsChecked="{Binding IsShift}" Margin="0,0,16,6" FontWeight="Medium"/>
                            <CheckBox Content="Alt" IsChecked="{Binding IsAlt}" Margin="0,0,16,6" FontWeight="Medium"/>
                            <CheckBox Content="Win" IsChecked="{Binding IsWin}" Margin="0,0,16,6" FontWeight="Medium"/>
                        </WrapPanel>

                        <!-- Key selector and preview -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_KeyLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableKeys}"
                                      SelectedItem="{Binding SelectedKey}"
                                      Padding="6,4"/>

                            <Border Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource HotkeyBoxBackgroundBrush}"
                                    BorderBrush="{DynamicResource HotkeyBoxBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <TextBlock Text="{Binding HotkeyPreviewText}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource HotkeyBoxForegroundBrush}"
                                           FontSize="13"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Service and Languages Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_ServiceCardTitle}" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_ProviderLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableProviders}"
                                      SelectedValuePath="Provider"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding SelectedProvider}"
                                      Padding="6,4"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_SourceLanguageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableSourceLanguages}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding SelectedSourceLanguage}"
                                      Padding="6,4"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_TargetLanguageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTargetLanguages}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding SelectedTargetLanguage}"
                                      Padding="6,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Theme / Appearance Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_ThemeCardTitle}" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_ThemeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedValuePath="Theme"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding SelectedTheme}"
                                      Padding="6,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Window Behavior Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_WindowBehaviorCardTitle}" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_PositionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding PositionMode}"
                                      Padding="6,4">
                                <ComboBoxItem Content="{DynamicResource Settings_PositionNearCursor}" Tag="{x:Static models:WindowPositionMode.NearCursor}"/>
                                <ComboBoxItem Content="{DynamicResource Settings_PositionCenter}" Tag="{x:Static models:WindowPositionMode.CenterScreen}"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AutoCloseLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableAutoCloseOptions}"
                                      SelectedValuePath="Seconds"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding AutoCloseSeconds}"
                                      Padding="6,4"/>
                        </Grid>

                        <CheckBox Content="{DynamicResource Settings_CloseOnEsc}"
                                  IsChecked="{Binding CloseOnEsc}"
                                  Margin="0,0,0,6"/>

                        <CheckBox Content="{DynamicResource Settings_CloseOnClickOutside}"
                                  IsChecked="{Binding CloseOnClickOutside}"
                                  Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- 6. Network and Startup Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_SystemCardTitle}" Style="{StaticResource SectionTitleStyle}"/>

                        <CheckBox Content="{DynamicResource Settings_StartWithWindows}"
                                  IsChecked="{Binding StartWithWindows}"
                                  FontWeight="Medium"
                                  Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource Settings_RequestTimeoutLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding FormattedRequestTimeoutText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Slider Grid.Row="1" Grid.ColumnSpan="2"
                                    Minimum="2"
                                    Maximum="30"
                                    Value="{Binding RequestTimeoutSeconds}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Margin="0,6,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 7. About and Author Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_AboutCardTitle}" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Author / GitHub Icon Badge -->
                            <Border Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="8"
                                    Background="{DynamicResource HotkeyBoxBackgroundBrush}"
                                    BorderBrush="{DynamicResource HotkeyBoxBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <Path Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                                      Fill="{DynamicResource HotkeyBoxForegroundBrush}"
                                      Width="22"
                                      Height="22"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Author & Link Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{DynamicResource Settings_AuthorLabel}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AuthorName}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock FontSize="12">
                                    <Hyperlink NavigateUri="{Binding GitHubUrl}"
                                               Command="{Binding OpenGitHubCommand}"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="{DynamicResource PrimaryButtonBackgroundBrush}"
                                               ToolTip="https://github.com/egladkov/">
                                        <Run Text="https://github.com/egladkov/"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <!-- GitHub Action Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenGitHubCommand}"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Settings_OpenGitHubTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="GitHub" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ↗" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Message Banner -->
        <Border Grid.Row="2"
                Margin="0,8,0,8"
                Padding="10,8"
                CornerRadius="6"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="{DynamicResource Common_ResetDefaults}"
                    Command="{Binding ResetDefaultsCommand}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Common_Close}"
                        Command="{Binding CloseCommand}"
                        Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Common_Save}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
