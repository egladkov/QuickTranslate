<Window x:Class="QuickTranslate.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickTranslate.ViewModels"
        xmlns:infra="clr-namespace:QuickTranslate.Infrastructure"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TranslationViewModel}"
        Title="QuickTranslate"
        Icon="{x:Static infra:AppIcon.ImageSource}"
        Width="440"
        MinWidth="440"
        MaxWidth="440"
        MinHeight="180"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="FluentIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource IconButtonHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IconButtonHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource IconButtonPressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer container with shadow -->
    <Border Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.3"/>
        </Border.Effect>

        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Content -->
                    <RowDefinition Height="*"/>
                    <!-- Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with drag support -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource HeaderBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="11,11,0,0"
                        Padding="12,10"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Languages and Provider badges -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BadgeSourceBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding SourceLanguageDisplay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BadgeSourceForegroundBrush}"/>
                            </Border>

                            <TextBlock Text="→"
                                       Margin="6,0"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BadgeArrowBrush}"/>

                            <Border Background="{DynamicResource BadgeTargetBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding TargetLanguageDisplay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BadgeTargetForegroundBrush}"/>
                            </Border>

                            <Border Background="{DynamicResource BadgeProviderBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ServiceProviderDisplay}"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource BadgeProviderForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource FluentIconButton}"
                                Command="{Binding CloseCommand}"
                                Width="26" Height="26"
                                ToolTip="{DynamicResource Translation_CloseTooltip}">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="14,10">
                    <Grid.RowDefinitions>
                        <!-- Original Text Area -->
                        <RowDefinition Height="Auto"/>
                        <!-- Translation Area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Original Text Box (Editable, doesn't disappear when typing) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Placeholder when empty -->
                            <TextBlock Grid.Row="0"
                                       Text="{DynamicResource Translation_InputPlaceholder}"
                                       IsHitTestVisible="False"
                                       FontSize="12"
                                       Foreground="{DynamicResource InputPlaceholderBrush}"
                                       Margin="4,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="InputTextBox"
                                     Grid.Row="0"
                                     Text="{Binding OriginalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource InputTextBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     MinHeight="28"
                                     MaxHeight="90"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsSourceReadOnly}"
                                     KeyDown="InputTextBox_KeyDown"/>

                            <!-- Translate button if user is manually entering text -->
                            <Grid Grid.Row="1"
                                  Margin="0,4,0,0"
                                  Visibility="{Binding IsTranslateButtonVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Button HorizontalAlignment="Right"
                                        Content="{DynamicResource Translation_TranslateButton}"
                                        Command="{Binding ManualTranslateCommand}"
                                        Padding="8,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Background="{DynamicResource TranslateButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TranslateButtonForegroundBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource TranslateButtonHoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Translation Result Section -->
                    <Grid Grid.Row="1" MinHeight="60">
                        <!-- Loading View -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                            <ProgressBar IsIndeterminate="True"
                                         Width="140"
                                         Height="4"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                         Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                            <TextBlock Text="{DynamicResource Translation_Translating}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Error View -->
                        <StackPanel VerticalAlignment="Center"
                                    Margin="4"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                            <Border Background="{DynamicResource StatusErrorBackgroundBrush}"
                                    BorderBrush="{DynamicResource StatusErrorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="⚠️" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Translation_ErrorTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource StatusErrorTitleBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource StatusErrorForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Translation Output Text (Prominent) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="260"
                                      Padding="2">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <Border x:Name="TranslationResultContainer"
                                    Background="Transparent"
                                    MinHeight="50"
                                    MouseLeftButtonUp="TranslationResult_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ToolTip" Value="{DynamicResource Translation_ClickToCopy}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                <Setter Property="ToolTip" Value="{DynamicResource Translation_Copied}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock x:Name="TranslationTextBlock"
                                           Text="{Binding TranslatedText}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           LineHeight="20"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Footer / Action Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource FooterBackgroundBrush}"
                        BorderBrush="{DynamicResource FooterBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hint -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CloseHintText}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextHintBrush}"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Copy Button -->
                            <Button Command="{Binding CopyTranslationCommand}"
                                    Padding="10,6"
                                    Cursor="Hand"
                                    FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- Visual feedback when copied -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                <Setter Property="Background" Value="#16A34A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📋"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource Translation_CopyButton}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource Translation_Copied}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
