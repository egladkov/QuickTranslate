<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors and Brushes -->
    
    <!-- Window and Cards -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#202024"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#323238"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#F4F4F5"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextHintBrush" Color="#71717A"/>

    <!-- Input Box -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#323238"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#71717A"/>

    <!-- Primary Action Button -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>

    <!-- Secondary Button -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#2E2E33"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#424248"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#27272A"/>

    <!-- Window Headers and Footers -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E1E22"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#2E2E34"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#1E1E22"/>
    <SolidColorBrush x:Key="FooterBorderBrush" Color="#2E2E34"/>

    <!-- Icon Buttons (Close, etc.) -->
    <SolidColorBrush x:Key="IconButtonForegroundBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="IconButtonHoverBackgroundBrush" Color="#2E2E33"/>
    <SolidColorBrush x:Key="IconButtonHoverForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IconButtonPressedBackgroundBrush" Color="#3F3F46"/>

    <!-- Language Badges -->
    <SolidColorBrush x:Key="BadgeSourceBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BadgeSourceForegroundBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="BadgeTargetBackgroundBrush" Color="#143525"/>
    <SolidColorBrush x:Key="BadgeTargetForegroundBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="BadgeProviderBackgroundBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="BadgeProviderForegroundBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="BadgeArrowBrush" Color="#71717A"/>

    <!-- Hotkey Preview Badge -->
    <SolidColorBrush x:Key="HotkeyBoxBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="HotkeyBoxBorderBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="HotkeyBoxForegroundBrush" Color="#60A5FA"/>

    <!-- Status Messages and Banners -->
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#047857"/>
    <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#450A0A"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="StatusErrorTitleBrush" Color="#F87171"/>

    <!-- Translation Window Specifics -->
    <SolidColorBrush x:Key="TranslateButtonBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TranslateButtonForegroundBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="TranslateButtonHoverBackgroundBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#2E2E34"/>

    <!-- ComboBox Brushes -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#323238"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#202024"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#2E2E33"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ComboBoxArrowBrush" Color="#A1A1AA"/>

</ResourceDictionary>
